# ---------------------------------------------------------------------------
# Xorv — copy to .env and fill in. NEVER commit .env.
# Claim Arc testnet USDC at https://faucet.circle.com (pick Arc Testnet).
# ---------------------------------------------------------------------------

# --- Arc network ------------------------------------------------------------
# CAIP-2, as x402 expects. Arc testnet is chain 5042002; mainnet is 5042.
XORV_NETWORK=eip155:5042002
# Override the public RPC with your own endpoint if you have one.
XORV_RPC_URL=https://rpc.testnet.arc.network

# --- Broker operator / facilitator ------------------------------------------
# This account relays every buyer's signed authorization and pays the fee, so a
# job poster needs nothing but the USDC they are spending. Keep it funded.
#
# Only a KEY. The address is derived from it — there is no second value to set
# and no way for the two to disagree.
XORV_OPERATOR_KEY=0x...              # 32 bytes of hex

# --- Audit log --------------------------------------------------------------
# The XorvLog contract: provider registrations, liveness and settled receipts,
# as indexed events. Deploy with `pnpm deploy:log`, then paste the address here.
# Leave blank to run without an audit trail — the network still works, it just
# records nothing publicly.
XORV_LOG_ADDRESS=
# Block the contract was deployed at. Without it a log read has to walk back
# from the head one window at a time; the RPC rejects an unbounded range.
XORV_LOG_FROM_BLOCK=

# --- Broker HTTP ------------------------------------------------------------
XORV_BROKER_PORT=8402
XORV_BROKER_URL=http://localhost:8402
# Comma-separated origins allowed to call the broker from a browser.
XORV_CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Protocol fee in basis points taken from each job (0 = 100% to the provider).
XORV_FEE_BPS=0

# --- Demo accounts ----------------------------------------------------------
# The buyer for scripts and for the app's no-wallet fallback. It needs USDC and
# no gas: it signs authorizations and never broadcasts.
XORV_DEMO_PAYER_KEY=
# The provider that receives job payments. Needs nothing — it only receives.
XORV_DEMO_PROVIDER_KEY=
# Addresses are optional, and only so the operator scripts can report on them.
XORV_DEMO_PAYER_ADDRESS=
XORV_DEMO_PROVIDER_ADDRESS=

# --- Frontends --------------------------------------------------------------
NEXT_PUBLIC_XORV_BROKER_URL=http://localhost:8402
NEXT_PUBLIC_XORV_NETWORK=eip155:5042002

# --- MongoDB (optional) -----------------------------------------------------
# When set, Mongo is the restore source on boot and SQLite is the write
# guarantee: every job is written to disk synchronously and mirrored to Mongo in
# the background, so an outage can never fail a job that was already paid for.
XORV_MONGO_URI=
XORV_MONGO_DB=xorv

# --- Stablecoin -------------------------------------------------------------
# The ERC-20 the network prices in. Defaults to Arc's native USDC — a Circle
# FiatTokenV2 at 0x3600…0000, the same address on both networks. Override to
# point at a different issuer or a test token.
#
# It must implement EIP-3009 `transferWithAuthorization`. Without that a buyer
# would have to broadcast their own transaction and pay their own gas, which is
# the entire thing this project exists to avoid.
XORV_STABLECOIN=
