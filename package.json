{
  "name": "kazuo-arc",
  "version": "0.1.0",
  "private": true,
  "description": "Kazuo — a decentralized AI capacity network. Rent out your idle Claude/Codex/Grok subscription, get paid per job in USDC over x402 on Arc.",
  "license": "MIT",
  "author": "Nivesh Gajengi <niveshgajengi@gmail.com>",
  "homepage": "https://github.com/nickthelegend/kazuo-arc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickthelegend/kazuo-arc.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "build": "pnpm -r --filter=./packages/** --filter=./services/** build",
    "build:all": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter=./packages/** --filter=./services/** --filter=kazuo-app test",
    "broker": "pnpm --filter @kazuo/broker dev",
    "app": "pnpm --filter kazuo-app dev",
    "landing": "pnpm --filter kazuo-landing dev",
    "cli": "pnpm --filter @kazuo/cli dev",
    "mcp": "pnpm --filter @kazuo/mcp dev",
    "usdc": "pnpm --filter @kazuo/broker usdc",
    "setup": "pnpm --filter @kazuo/broker setup",
    "deploy:log": "pnpm dlx tsx scripts/deploy-log.mts",
    "m1": "pnpm dlx tsx scripts/m1-settle.mts"
  },
  "keywords": [
    "x402",
    "arc",
    "circle",
    "usdc",
    "ai-agents",
    "micropayments",
    "claude-code",
    "marketplace",
    "agentic-payments",
    "eip-3009"
  ],
  "devDependencies": {
    "solc": "0.8.28"
  }
}
