{
  "name": "@kazuo/cli",
  "version": "0.1.0",
  "description": "Rent out your idle Claude / Codex / Grok subscription and get paid per job in USDC over x402 on Arc.",
  "license": "MIT",
  "author": "Nivesh Gajengi <niveshgajengi@gmail.com>",
  "homepage": "https://github.com/nickthelegend/kazuo-arc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickthelegend/kazuo-arc.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/nickthelegend/kazuo-arc/issues",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "bin": {
    "kazuo": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "x402",
    "arc",
    "usdc",
    "ai",
    "claude-code",
    "codex",
    "grok",
    "micropayments",
    "cli",
    "passive-income",
    "agent-marketplace"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@kazuo/protocol": "workspace:*",
    "@worldcoin/agentkit": "^0.2.1",
    "@worldcoin/idkit-core": "4.2.4",
    "@x402/core": "~2.21.0",
    "@x402/evm": "~2.21.0",
    "@x402/fetch": "~2.21.0",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "qrcode": "^1.5.4",
    "viem": "^2.40.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "~5.9.0",
    "vitest": "^3.2.4"
  }
}
