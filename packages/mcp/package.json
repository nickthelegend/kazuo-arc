{
  "name": "@xorv/mcp",
  "version": "0.1.0",
  "description": "MCP server for Xorv \u2014 lets any agent buy AI capacity from the network and pay for it over x402 on Arc.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "xorv-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "x402",
    "arc",
    "usdc",
    "ai-agents",
    "model-context-protocol"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@x402/core": "~2.21.0",
    "@x402/evm": "~2.21.0",
    "@x402/fetch": "~2.21.0",
    "@xorv/protocol": "workspace:*",
    "viem": "^2.40.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.23.1",
    "typescript": "~5.9.0",
    "vitest": "^3.2.4"
  }
}
